{
  "manifest_version": 3,
  "name": "Grab",
  "version": "0.3.0",
  "description": "Send the links on a page, or every download you click, to Grab.",
  "key": "",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "scripting",
    "cookies",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Grab",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16-off.png",
      "48": "icon48-off.png",
      "128": "icon128-off.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Open Grab (links on this page)"
    },
    "toggle-auto": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Turn \u201cCatch my downloads\u201d on or off"
    }
  }
}
